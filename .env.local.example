# Copy to .env.local and replace the entire placeholder privately.
# Use the Atlas-generated URI with your explicitly assigned developer database.
# Dashboard login and database credentials are separate. Never commit credentials.
MONGO_URI={mongo-uri-with-explicit-developer-database-here}

# Private team management access. Use a unique password of at least 16 characters.
# These variables are server-only. Never use a NEXT_PUBLIC_ prefix.
MANAGEMENT_USERNAME=team
MANAGEMENT_PASSWORD={replace-with-a-long-random-password}

# Optional deliberate live smoke test. Use HTTPS remotely, loopback HTTP locally.
# LIVE_BASE_URL=https://your-verified-deployment.vercel.app
