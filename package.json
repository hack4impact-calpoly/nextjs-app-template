{
  "name": "nextjs-app-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests/unit tests/acceptance-*.ts tests/controlled-server.ts scripts/*.ts vitest.config.mts",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "preview:offerings": "node scripts/offering-preview-server.mjs",
    "test": "npm run test:unit && npm run test:regression && npm run test:acceptance:cli && npm run test:acceptance:db && npm run test:acceptance:app",
    "test:db": "node --test tests/database-checker.test.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:check:write": "node scripts/check-database.mjs --write",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "preview:special-offerings": "node scripts/special-offerings-preview.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:regression": "node --test --import tsx tests/offerings-http.test.mjs tests/database-checker.test.mjs tests/offering-form.test.mjs src/lib/offerings.test.ts tests/special-offering-control.test.mjs tests/seed-offerings.test.mjs tests/offering-storage.test.ts tests/offering-seed-command.test.mjs",
    "test:storage": "node --test --import tsx tests/offering-storage.test.ts tests/offering-seed-command.test.mjs",
    "db:seed": "node --import tsx scripts/seed-offerings.ts",
    "test:live": "node --import tsx scripts/verify-live.ts",
    "acceptance": "node --import tsx scripts/acceptance-runner.ts",
    "acceptance:db": "node --import tsx scripts/database-smoke.ts",
    "test:acceptance": "vitest run tests/unit/acceptance-runner.test.ts && npm run test:acceptance:cli && npm run test:acceptance:db",
    "test:acceptance:cli": "node --test --import tsx tests/acceptance-cli.test.ts",
    "test:acceptance:db": "node --test --import tsx tests/acceptance-lifecycle.test.ts",
    "test:acceptance:app": "node --test --import tsx tests/acceptance-application.test.ts",
    "preflight": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "mongoose": "^8.24.5",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "eslint-config-prettier": "^9",
    "eslint-plugin-prettier": "^5",
    "husky": "^9",
    "jsdom": "^26.1.0",
    "lint-staged": "^15",
    "mongodb-memory-server-core": "^10.4.3",
    "prettier": "^3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "24.x"
  }
}
